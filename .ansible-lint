---
# ansible-lint configuration for the venafi.machine_identity collection, aligned with the Red Hat
# partner certification rules:
# https://docs.ansible.com/projects/partner-certification-requirements/static-analysis/
#
#   * profile — production, the profile Automation Hub certification uses.
#   * exclude_paths — only directories that hold no collection content and are not shipped in
#     the tarball (CI, unit and smoke tests). Content directories (plugins/, roles/) are never
#     excluded.
#   * skip_list — var-naming[no-role-prefix] only. The role variables (for example
#     credentials_file, ssh_*, set_policy_run_once) are the public interface of the roles;
#     renaming them would break existing playbooks. Red Hat accepts skipping var-naming for
#     collections past 1.0.0.
#   * warn_list — no-log-password, as Red Hat recommends.
#
# The F5, Citrix ADC and IIS example playbooks under roles/certificate/examples/ call modules
# from collections this collection does not depend on; .ansible-lint-ignore lists them.
profile: production

exclude_paths:
  - .github/
  - tests/
  - molecule/
  - changelogs/

skip_list:
  - var-naming[no-role-prefix]

warn_list:
  - no-log-password
